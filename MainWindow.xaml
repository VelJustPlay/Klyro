<Window x:Class="LightweightBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Klyro Browser" Icon="Assets/Klyro.ico"
        Width="1180" Height="760" MinWidth="560" MinHeight="360"
        WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseMove="Window_PreviewMouseMove"
        StateChanged="Window_StateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#09080D" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111017" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#191721" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F2FA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8E899A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#282431" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B982FF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#D184FF" Offset="0" />
      <GradientStop Color="#8C4DFF" Offset="0.5" />
      <GradientStop Color="#5735D8" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="ChromeButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#282431" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#393342" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CloseChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C42B1C" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#9E2115" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <GeometryGroup x:Key="KlyroMarkGeometry">
      <PathGeometry Figures="M 12,1 C 18,1 22,5 22,11 C 22,17 18,21 12,21 C 8,21 5,19 3,16 L 7,13 C 8,15 10,16 12,16 C 15,16 17,14 17,11 C 17,8 15,6 12,6 C 10,6 8,7 7,9 L 3,6 C 5,3 8,1 12,1 Z" />
      <PathGeometry Figures="M 1,10 L 9,10 L 12,12 L 9,14 L 1,14 L 4,12 Z" />
    </GeometryGroup>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Grid Background="Transparent">
              <Border x:Name="TabSurface" Background="Transparent" CornerRadius="9" />
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
              <Border x:Name="TabAccent" Height="2" Margin="10,0" VerticalAlignment="Bottom"
                      Background="{DynamicResource AccentGradientBrush}" Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="#201A2B" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter TargetName="TabAccent" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="MainLayout">
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="22" />
    </Grid.RowDefinitions>

        <Border x:Name="TabBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource AccentGradientBrush}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True" Margin="10,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource ChromeButtonStyle}" Content="—"
                  Click="MinimizeWindow_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
          <Button x:Name="WindowStateButton" Style="{StaticResource ChromeButtonStyle}" Content="□"
                  Click="ToggleWindowState_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize" />
          <Button Style="{StaticResource CloseChromeButtonStyle}" Content="×"
                  Click="CloseWindow_Click" ToolTip="Close" AutomationProperties.Name="Close" />
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="+" Width="32" Padding="0" FontSize="18"
                ToolTip="New tab (Ctrl+T)" Click="NewTab_Click"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        <Button DockPanel.Dock="Right" Content="▤" Width="32" Padding="0" FontSize="16"
                ToolTip="New notes tab" AutomationProperties.Name="New notes tab"
                Click="NewNotesTab_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,14,0">
          <Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource AccentGradientBrush}"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <RotateTransform x:Name="LogoRotation" Angle="0" />
            </Border.RenderTransform>
            <Border.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LogoRotation" Storyboard.TargetProperty="Angle"
                                     To="8" Duration="0:0:0.18" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LogoRotation" Storyboard.TargetProperty="Angle"
                                     To="0" Duration="0:0:0.2" />
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Border.Triggers>
            <Path Data="{StaticResource KlyroMarkGeometry}" Fill="White" Width="15" Height="13"
                  Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Klyro" Margin="8,0,0,0" VerticalAlignment="Center"
                     FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
        </StackPanel>
        <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" AllowDrop="True"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    SizeChanged="Tabs_SizeChanged" PreviewMouseWheel="Tabs_PreviewMouseWheel"
                    PreviewMouseLeftButtonDown="Tabs_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tabs_PreviewMouseMove" DragOver="Tabs_DragOver" Drop="Tabs_Drop"
                    SelectionChanged="Tabs_SelectionChanged">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <ScrollViewer x:Name="TabScrollViewer" HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled" CanContentScroll="False"
                            Focusable="False" VerticalAlignment="Center">
                <ScrollViewer.Resources>
                  <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Height" Value="3" />
                    <Setter Property="MinHeight" Value="3" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Opacity" Value="0.4" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                          <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                              <Track.Thumb>
                                <Thumb>
                                  <Thumb.Template>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                      <Border Background="#8E899A" CornerRadius="2" />
                                    </ControlTemplate>
                                  </Thumb.Template>
                                </Thumb>
                              </Track.Thumb>
                            </Track>
                          </Grid>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter Property="Opacity" Value="0" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ScrollViewer.Resources>
                <ItemsPresenter />
              </ScrollViewer>
            </ControlTemplate>
          </TabControl.Template>
          <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </TabControl.ItemsPanel>
        </TabControl>
      </DockPanel>
    </Border>

        <Border x:Name="NavigationBar" Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="8,3">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button Content="←" Width="32" Padding="3,4" Click="Back_Click" ToolTip="Back (Alt+Left)" />
            <Button Content="→" Width="32" Padding="3,4" Click="Forward_Click" ToolTip="Forward (Alt+Right)" />
            <Button Content="↻" Width="32" Padding="3,4" Click="Reload_Click" ToolTip="Reload (Ctrl+R)" />
            <Button Content="⌂" Width="32" Padding="3,4" Click="Home_Click" ToolTip="New blank tab" />
          </StackPanel>
          <TextBox x:Name="AddressBox" Grid.Column="1" Margin="4,2" Padding="12,6"
                   VerticalContentAlignment="Center" MinWidth="100" MinHeight="36" FontSize="12"
                   Background="{DynamicResource SurfaceAltBrush}" Foreground="#FFFFFF"
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                   CaretBrush="#D184FF" SelectionBrush="#8C4DFF" SelectionTextBrush="White"
                   ToolTip="Type a web address, search DuckDuckGo, or use klyro: to search saved sites (Ctrl+L)"
                   KeyDown="AddressBox_KeyDown" />
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Width="34" Height="32" Padding="0" Margin="0,0,4,0" Click="Downloads_Click"
                    ToolTip="Show downloads" AutomationProperties.Name="Show downloads">
              <Path Data="M 12,2 L 12,14 M 7,9 L 12,14 L 17,9 M 4,18 L 20,18"
                    Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource PrimaryTextBrush}"
                    StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" />
            </Button>
            <Button Width="34" Height="32" Padding="0" Click="Settings_Click"
                    ToolTip="View browsing history and browser settings"
                    AutomationProperties.Name="Settings">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>

    <Grid x:Name="EmptyPage" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="72" Height="72" Margin="0,0,0,16" CornerRadius="22"
                Background="{DynamicResource AccentGradientBrush}">
          <Path Data="{StaticResource KlyroMarkGeometry}" Fill="White" Width="42" Height="37"
                Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Klyro" HorizontalAlignment="Center"
                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Private web search with DuckDuckGo inside Klyro, or type “klyro: words” for saved sites" Margin="0,4,0,0"
                   HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
        <Button Content="Manage local search index" Padding="12,7" Margin="0,14,0,0"
                HorizontalAlignment="Center" Click="SearchIndex_Click" />
      </StackPanel>
    </Grid>
    <Grid x:Name="BrowserHost" Grid.Row="2" Visibility="Collapsed" />
    <Border x:Name="DownloadPanel" Grid.Row="2" Width="380" MaxHeight="300"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
            Padding="12" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
            Visibility="Collapsed">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Content="×" Padding="8,2" Click="HideDownloads_Click"
                  ToolTip="Hide downloads" />
          <TextBlock Text="Downloads" FontWeight="SemiBold" FontSize="13"
                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="245">
          <StackPanel x:Name="DownloadsList" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="10,1"
               Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Text="Ready" />
  </Grid>
</Window>
